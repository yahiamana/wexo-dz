generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  failedAttempts Int      @default(0)
  lockedUntil    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id           String   @id @default(cuid())
  name         String
  email        String?
  phone        String?
  businessType String?
  message      String
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Service {
  id        String   @id @default(cuid())
  icon      String
  titleEn   String
  titleFr   String
  titleAr   String
  descEn    String
  descFr    String
  descAr    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteType {
  id         String   @id @default(cuid())
  slug       String   @unique
  titleEn    String
  titleFr    String
  titleAr    String
  descEn     String
  descFr     String
  descAr     String
  featuresEn String[]
  featuresFr String[]
  featuresAr String[]
  priceUSD   Float
  priceEUR   Float
  priceDZD   Float
  icon       String
  imageUrl   String?
  isPopular  Boolean  @default(false)
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PortfolioProject {
  id              String   @id @default(cuid())
  slug            String   @unique
  titleEn         String
  titleFr         String
  titleAr         String
  descEn          String
  descFr          String
  descAr          String
  contentEn       String?  @db.Text
  contentFr       String?  @db.Text
  contentAr       String?  @db.Text
  client          String?
  industry        String?
  websiteType     String?
  technologies    String[]
  featuresEn      String[]
  featuresFr      String[]
  featuresAr      String[]
  deliveryTime    String?
  challengeEn     String?  @db.Text
  challengeFr     String?  @db.Text
  challengeAr     String?  @db.Text
  solutionEn      String?  @db.Text
  solutionFr      String?  @db.Text
  solutionAr      String?  @db.Text
  resultsEn       String?  @db.Text
  resultsFr       String?  @db.Text
  resultsAr       String?  @db.Text
  category        String
  imageUrl        String
  galleryImages   String[]
  liveUrl         String?
  isFeatured      Boolean  @default(false)
  isVisible       Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  profession String
  feedbackEn String
  feedbackFr String
  feedbackAr String
  rating     Int      @default(5)
  avatarUrl  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  valueEn   String
  valueFr   String
  valueAr   String
  updatedAt DateTime @updatedAt
}
